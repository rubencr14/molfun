# MinIO / S3-compatible storage (used with --minio flag)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=molfun-data
MINIO_SECURE=false

# Kinase pilot (SimpleFold backend)
MOLFUN_KINASE_DATA=/path/to/nomosis-kinases/data
MOLFUN_WORK_DIR=/path/to/kinase-pilot
MOLFUN_SIMPLEFOLD_CCD_RDB=/path/to/kinase-pilot/boltz/ccd.rdb
